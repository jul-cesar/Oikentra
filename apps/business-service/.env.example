DATABASE_URL=postgres://user:password@localhost:5432/oikentra_business
# Base64-encoded SPKI public PEM issued by auth-service. Never put the private key here.
INTERNAL_AUTH_PUBLIC_KEY_B64=replace-with-base64-spki-public-key
PORT=3000

# Event reminder worker (Resend).
RESEND_API_KEY=replace-with-resend-api-key
REMINDER_EMAIL_FROM=Oikentra <recordatorios@example.com>
REMINDER_POLL_INTERVAL_MS=30000

# Real recipient required for reminders when INTERNAL_AUTH_DEV_BYPASS=true.
INTERNAL_AUTH_DEV_USER_EMAIL=developer@example.com

# Optional Cloudflare R2 logo uploads.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=oikentra-assets
# Separate private bucket for task attachments. Do not expose it through a public domain.
R2_PRIVATE_BUCKET=oikentra-task-attachments
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# Public URL used for logo URLs returned to clients. Point this to your CDN
# (e.g. Cloudflare DNS proxied through cdn.oikentra.com) rather than the raw
# R2 bucket domain, so uploaded logos are served through the CDN.
R2_PUBLIC_BASE_URL=https://cdn.oikentra.com
