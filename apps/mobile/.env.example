# Base URL of the Better Auth backend.
# This MUST point to the production auth origin and MUST NOT end with a trailing slash.
EXPO_PUBLIC_AUTH_BASE_URL=https://api.oikentra.com/api/auth
EXPO_PUBLIC_BUSINESS_BASE_URL=https://api.oikentra.com/api/business

# Google OAuth client IDs.
# The web client ID is required for native Google Sign-In on both platforms.
# The iOS and Android client IDs are required for their respective native flows.
# These are public IDs; the server-side client secret MUST NOT be added here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
